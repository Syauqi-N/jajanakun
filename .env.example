DATABASE_URL="file:./dev.db"

# Admin utama (super admin) via env.
# PRODUKSI: app menolak start bila nilai kosong / masih contoh.
#   ADMIN_PASSWORD minimal 10 karakter.
#   ADMIN_SESSION_SECRET minimal 32 karakter — buat dengan: openssl rand -hex 32
ADMIN_EMAIL="admin@jajanakun.store"
ADMIN_PASSWORD="admin123"
ADMIN_SESSION_SECRET="ganti-dengan-string-random-panjang"

# SoqiPG payment gateway
SOQIPG_BASE_URL="https://api.soqipg.example"
SOQIPG_MERCHANT_ID=""
SOQIPG_API_KEY=""
# PRODUKSI: wajib diisi (webhook ditolak bila kosong).
SOQIPG_WEBHOOK_SECRET="ganti-webhook-secret"

# WhatsApp admin (link chat fallback)
NEXT_PUBLIC_ADMIN_WA="6281234567890"

# App — PRODUKSI: wajib https://… (mis. https://jajanakun.store)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (login pembeli)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set 1 agar tombol "Lanjutkan dengan Google" muncul di halaman masuk/daftar
NEXT_PUBLIC_GOOGLE_ENABLED=""
